{
  "manifest_version": 3,
  "name": "AI 回答存档",
  "version": "1.0.0",
  "description": "点选一条 AI 回答，自动滚动拼成一张长图（字不变小）并归档到本地文件夹，同时存一份 Markdown。",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI 回答存档" },
  "commands": {
    "start-pick": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "选择要存档的回答"
    }
  }
}
